PORT=5000
MONGODB_URI=mongodb://localhost:27017/examsphere-ai
JWT_SECRET=replace_with_a_strong_random_secret
FRONTEND_URL=http://localhost:3000

# ── Email / SMTP ──────────────────────────────────────────
# Gmail example: use an App Password, NOT your normal Gmail password.
# Go to: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
MAIL_FROM="ExamSphere AI" <your_gmail_address@gmail.com>

# ── Frontend URL (used inside reset-password emails) ──────
CLIENT_URL=http://localhost:3000
